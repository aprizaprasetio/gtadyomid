{
  "compilerOptions": {
    "paths": {
      "@api": ["./src/api"],
      "@api/*": ["./src/api/*"],
      "@app/*": ["./src/app/*"],
      "@infra/*": ["./src/infra/*"],
      "@domain/*": ["./src/domain/*"],
      "@tests/*": ["./tests/*"]
    },
    "strict": true,
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"]
  },
  "include": ["src/**/*", "tests/**/*"]
}
